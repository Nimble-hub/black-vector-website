# Black Vector authentication core. Generate at least 32 random bytes for the secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Manual email/password accounts and verification/reset delivery.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Black Vector <access@blackvector.game>"

# Google OAuth callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth callback: {BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Steam Web API key. Login callback: {BETTER_AUTH_URL}/api/auth/steam/callback
# Account-link callback: {BETTER_AUTH_URL}/api/steam/link/callback
STEAM_API_KEY=
